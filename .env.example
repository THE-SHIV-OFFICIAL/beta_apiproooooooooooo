APP_URL=https://your-app.up.railway.app
BOT_NAME=BetaAPI
UPI_ID=yourname@upi
# ===== Required =====
TELEGRAM_BOT_TOKEN=123456:ABC-your-telegram-bot-token
ADMIN_IDS=123456789
ADMIN_KEY=apna-secret-admin-key
# ===== API key style: SHIV/ISTU + 12 digits + BETA =====
KEY_PREFIXES=SHIV,ISTU
KEY_SUFFIX=BETA
KEY_DIGITS=12
# ===== Speed / cache =====
REDIS_URL=redis://default:pass@host:6379
WEB_CONCURRENCY=4
# ===== Cookies (optional) — cookies/ folder ya bot ko .txt bhejo =====
COOKIE_COOLDOWN=1800
# ===== Proxy (optional) — comma separated =====
PROXY_LIST=http://user:pass@45.38.107.97:6014,http://user:pass@31.59.20.176:6754
# auto = proxy+cookies dono ho to proxy pehle, cookies backup
# cookies = sirf cookies,  proxy = sirf proxy
ROUTE_MODE=auto
# ===== Auto payment gateway (QR + auto verify) =====
PAY_API_URL=https://betapaymentgateway.up.railway.app
PAY_API_KEY=ANJALI_your_gateway_key
PAY_QR_MINUTES=10
PAY_POLL_SECONDS=8
